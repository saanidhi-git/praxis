# ---------------------------------------------------------------
# Praxis â€” environment template.
# Copy to .env and fill in. NEVER commit the real .env.
#
# NOTE: every value below has a working default or a mock fallback.
# The entire stack runs and all tests pass with NO API keys at all
# (LLM_PROVIDER=mock). See README "Running without an API key".
# ---------------------------------------------------------------

NODE_ENV=development

# --- API ---
API_PORT=4000
JWT_SECRET=change-me-in-production
CORS_ORIGIN=http://localhost:3000

# --- Database ---
# Local standalone MongoDB (this machine). Transactions unavailable on
# standalone; the repository layer degrades to atomic compare-and-swap.
MONGODB_URI=mongodb://127.0.0.1:27017/praxis
# Production (MongoDB Atlas â€” replica set, transactions enabled):
# MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>/praxis?retryWrites=true&w=majority

# --- LLM provider ---
# mock | groq   ("mock" is deterministic, offline, and requires no key)
LLM_PROVIDER=mock
GROQ_API_KEY=
GROQ_TEXT_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# --- ML service ---
ML_API_URL=http://127.0.0.1:8000
ML_API_TIMEOUT_MS=5000

# --- Sandbox executor ---
EXECUTOR_URL=http://127.0.0.1:4100
# subprocess | docker  (docker adapter is stubbed; Docker is not installed here)
EXECUTOR_ADAPTER=subprocess
EXECUTOR_TIMEOUT_MS=5000
EXECUTOR_MEMORY_MB=128
EXECUTOR_MAX_OUTPUT_BYTES=65536

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:4000
